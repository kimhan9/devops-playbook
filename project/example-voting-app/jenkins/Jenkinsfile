pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        DOCKERHUB_USER   = 'kimhan9'
        DOCKERHUB_CREDS  = credentials('dockerhub')
        DOCKER_BUILDKIT  = '1'
    }

    stages {
        stage('Checkout from Git') {
            steps {
                git branch: 'main', url: 'https://github.com/dockersamples/example-voting-app.git'
            }
        }

        stage('Prepare') {
            steps {
                script {
                    env.IMAGE_TAG = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                }
                echo "Tagging images with ${env.IMAGE_TAG}"
            }
        }

        stage('Docker Hub login') {
            steps {
                sh 'echo "$DOCKERHUB_CREDS_PSW" | docker login -u "$DOCKERHUB_CREDS_USR" --password-stdin'
            }
        }

        stage('Build & push') {
            matrix {
                axes {
                    axis {
                        name 'SERVICE'
                        values 'vote', 'result', 'worker'
                    }
                }
                stages {
                    stage('Build') {
                        steps {
                            sh '''
                                IMAGE="$DOCKERHUB_USER/examplevotingapp_$SERVICE"
                                docker build -t "$IMAGE:$IMAGE_TAG" -t "$IMAGE:latest" "./$SERVICE"
                            '''
                        }
                    }
                    stage('Push') {
                        steps {
                            sh '''
                                IMAGE="$DOCKERHUB_USER/examplevotingapp_$SERVICE"
                                docker push "$IMAGE:$IMAGE_TAG"
                                docker push "$IMAGE:latest"
                            '''
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            sh 'docker logout || true'
        }
        success {
            echo "Pushed kimhan9/examplevotingapp_{vote,result,worker}:${env.IMAGE_TAG} and :latest"
        }
    }
}
